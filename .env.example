# =============================================================
# Online GK Quiz Generator - Environment Configuration Template
# Copy this file to .env and configure your values.
# =============================================================

# Toggle AWS Integration (true = Amazon RDS, S3, SNS, CloudWatch; false = Local fallbacks)
USE_AWS=false

# AWS Infrastructure Settings (EC2 uses IAM Role; no access keys required in code)
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-quizgen-results-bucket
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:quiz-score-notifications
CLOUDWATCH_LOG_GROUP=QuizGen-App-Logs

# Database Configuration (Local MySQL or Amazon RDS MySQL Endpoint)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=quiz-app

# Flask Application Settings
SECRET_KEY=generate-a-strong-random-secret-key
FLASK_ENV=production
PORT=5000
